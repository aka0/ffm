<Window x:Class="FFM.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FFM" Icon="app.ico" Height="920" Width="1480" MinHeight="760" MinWidth="1080" Background="#F5F7F8" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#1B2D32"/><SolidColorBrush x:Key="Muted" Color="#687A7E"/><SolidColorBrush x:Key="Line" Color="#E0E8E8"/><SolidColorBrush x:Key="Teal" Color="#147C73"/>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="13"/><Setter Property="BorderBrush" Value="#D9E2E2"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#147C73"/><Setter Property="BorderBrush" Value="#147C73"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9E2E2"/><Setter Property="FontSize" Value="13"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E0E8E8" BorderThickness="0,0,0,1"><DockPanel Margin="26,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#147C73" CornerRadius="8" Padding="9,6"><TextBlock Text="ffm" Foreground="White" FontWeight="Bold"/></Border><StackPanel Margin="12,0"><TextBlock Text="FFM" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Football Manager Facepack Manager" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button x:Name="SourcesButton" Margin="0,0,8,0" Content="Save &amp; facepack" Click="Sources_Click"/><Button x:Name="ProviderButton" Content="AI provider" Margin="0,0,8,0" Click="Connect_Click"/><TextBlock Text="SAVE READ-ONLY" VerticalAlignment="Center" Foreground="#147C73" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/></StackPanel></DockPanel></Border>
  <Border Grid.Row="1" Background="#EEF5F3" Padding="26,10"><TextBlock x:Name="SourceStatus" Text="Choose the required facepack and save in Save &amp; facepack to begin." Foreground="#32635D" FontSize="12"/></Border>
  <Grid Grid.Row="2" Margin="26,22"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#E0E8E8" BorderThickness="1" CornerRadius="10" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="FIND A PLAYER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/><TextBox x:Name="SearchBox" ToolTip="Search by player name or ID" TextChanged="Search_TextChanged"/><TextBlock x:Name="PlayerCount" Text="Player metadata loads from your save" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,9,0,12"/></StackPanel><ListBox x:Name="PlayerList" BorderThickness="0" SelectionChanged="Player_SelectionChanged" DisplayMemberPath="DisplayName"/></DockPanel></Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#E0E8E8" BorderThickness="1" CornerRadius="10" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Compare original" Click="Compare_Click"/><StackPanel><TextBlock x:Name="PlayerName" Text="Select a player" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="PlayerDetails" Text="Load player metadata from your save" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#F1F3F2" CornerRadius="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="CURRENT PORTRAIT" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}" Margin="12"/><Image x:Name="OriginalImage" Stretch="Uniform" Margin="12"/><TextBlock x:Name="OriginalPath" DockPanel.Dock="Bottom" Text="No mapped portrait" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="12"/></DockPanel></Border><Border Grid.Column="2" Background="#F1F3F2" CornerRadius="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="EDIT PREVIEW" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}" Margin="12"/><Image x:Name="EditedImage" Stretch="Uniform" Margin="12"/><TextBlock x:Name="PreviewStatus" DockPanel.Dock="Bottom" Text="Choose an edit and preview" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="12"/></DockPanel></Border></Grid><TextBlock x:Name="Activity" Grid.Row="2" Text="Ready" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/></Grid></Border>
   <Border Grid.Column="4" Background="White" BorderBrush="#E0E8E8" BorderThickness="1" CornerRadius="10" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="PORTRAIT CHANGES" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Alter Hairstyle" FontWeight="SemiBold" FontSize="12"/><ComboBox x:Name="HairstyleBox" Margin="0,5,0,12" SelectionChanged="Preset_Changed"><ComboBoxItem Content="Keep current hairstyle" IsSelected="True"/><ComboBoxItem Content="Buzz cut"/><ComboBoxItem Content="Crew cut"/><ComboBoxItem Content="Textured crop"/><ComboBoxItem Content="Undercut"/><ComboBoxItem Content="Slicked back"/></ComboBox><TextBlock Text="Add beard" FontWeight="SemiBold" FontSize="12"/><ComboBox x:Name="BeardBox" Margin="0,5,0,12" SelectionChanged="Preset_Changed"><ComboBoxItem Content="Keep current facial hair" IsSelected="True"/><ComboBoxItem Content="Light stubble"/><ComboBoxItem Content="Heavy stubble"/><ComboBoxItem Content="Short beard"/><ComboBoxItem Content="Full beard"/><ComboBoxItem Content="Goatee"/><ComboBoxItem Content="Circle beard"/><ComboBoxItem Content="Van Dyke"/><ComboBoxItem Content="Balbo"/></ComboBox><TextBlock Text="Age Appearance" FontWeight="SemiBold" FontSize="12"/><ComboBox x:Name="AgeBox" Margin="0,5,0,12" SelectionChanged="Preset_Changed" IsEnabled="False"><ComboBoxItem Content="Player age unavailable" IsSelected="True"/></ComboBox><TextBlock Text="Preserve the same face, pose, clothes, lighting and background. Selected features only." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,12"/><Expander Header="View / edit prompt" IsExpanded="False"><StackPanel><TextBox x:Name="PromptBox" TextChanged="Prompt_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="125" VerticalContentAlignment="Top"/><Button Content="Reset to selected changes" Margin="0,7,0,10" Click="ResetPrompt_Click"/></StackPanel></Expander><Button x:Name="PreviewButton" ToolTipService.ShowOnDisabled="True" Content="Edit in ChatGPT…" Style="{StaticResource Primary}" Margin="0,12,0,7" Click="Preview_Click"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="AcceptButton" Grid.Column="0" Content="Accept portrait" IsEnabled="False" Click="Accept_Click"/><Button x:Name="RejectButton" Grid.Column="2" Content="Reject" IsEnabled="False" Click="Reject_Click"/></Grid><Button x:Name="HistoryButton" Content="Version history" Margin="0,8,0,0" Click="History_Click"/></StackPanel></ScrollViewer></Border>
  </Grid><Border Grid.Row="3" Background="White" BorderBrush="#E0E8E8" BorderThickness="0,1,0,0">
   <Grid Margin="26,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="48"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="LoadStatus" Text="Ready · choose Save &amp; facepack to begin" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,24,0"/>
    <ProgressBar x:Name="LoadProgress" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="7" Foreground="#147C73" Background="#EAF0EF" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="Source loading progress"/>
    <TextBlock x:Name="LoadPercent" Grid.Column="2" Text="0%" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    <Button x:Name="CancelLoadButton" Grid.Column="3" Content="Cancel" Visibility="Collapsed" Click="CancelLoad_Click" Padding="10,5" Margin="14,0,0,0"/>
   </Grid>
  </Border>
 </Grid>
</Window>



