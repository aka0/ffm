<Window x:Class="FFM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFM" Icon="app.ico" Height="920" Width="1480" MinHeight="620" MinWidth="1240" Foreground="{StaticResource Ink}"
        Background="{StaticResource Canvas}" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True"
        PreviewDragOver="Portrait_DragOver" PreviewDrop="Portrait_Drop" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="26,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Teal}" CornerRadius="8" Padding="5"><Image Source="pack://application:,,,/FFM.App;component/app.ico" Width="30" Height="30" Stretch="Uniform" AutomationProperties.Name="FFM app icon"/></Border>
                    <StackPanel Margin="12,0"><TextBlock Text="FFM" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Football Manager Facepack Manager" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="SourcesButton" Style="{StaticResource Primary}" Margin="0,0,8,0" Content="_Save &amp; facepack" Click="Sources_Click"/>
                    <Button x:Name="ProviderButton" Style="{StaticResource Secondary}" Content="AI p_rovider" Margin="0,0,8,0" Click="Connect_Click"/>
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="8,4" Margin="8,0,0,0"><TextBlock Text="READ-ONLY" VerticalAlignment="Center" Foreground="{StaticResource Teal}" FontWeight="SemiBold" FontSize="10"/></Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#EEF5F3" Padding="26,8">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="SourceStatus" Text="Choose the required facepack and save in Save &amp; facepack to begin." Foreground="#32635D" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                <Border x:Name="RecoveryBanner" Grid.Row="1" Visibility="Collapsed" Background="#FFF4E8" BorderBrush="#E5B77C" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Open recovery folder" Click="OpenRecoveryFolder_Click" Margin="6,0" Padding="10,5"/>
                            <Button Content="Retry recovery" Click="RetryRecovery_Click" Padding="10,5"/>
                        </StackPanel>
                        <TextBlock x:Name="RecoveryDetails" TextWrapping="Wrap" MaxHeight="48" Foreground="#704500" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="26,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/>
                <ColumnDefinition Width="500" MinWidth="440" MaxWidth="600"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="FIND A PLAYER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                        <TextBox x:Name="SearchBox" AutomationProperties.Name="Find a player by name or ID" ToolTip="Search by player name or ID" TextChanged="Search_TextChanged"/>
                        <TextBlock x:Name="PlayerCount" Text="Player metadata loads from your save" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,9,0,12"/>
                        <CheckBox x:Name="HideUnresolvedCheckBox" Content="Hide unresolved" FontSize="11" ToolTip="Hide newgens whose name could not be read" Visibility="Collapsed" Checked="HideUnresolved_Changed" Unchecked="HideUnresolved_Changed" Margin="0,0,0,8"/>
                    </StackPanel>
                    <ListBox x:Name="PlayerList" AutomationProperties.Name="Newgen players" BorderThickness="0" SelectionChanged="Player_SelectionChanged">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,2" AutomationProperties.Name="{Binding DisplayName}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" FontWeight="Medium"/><DockPanel><TextBlock Text="Age " FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Age, TargetNullValue=—}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Id}" FontSize="10" Foreground="{StaticResource Muted}"/></DockPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Background="{StaticResource Line}"/>
            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,16">
                        <Button x:Name="CompareButton" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="Compare original" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="Compare_Click"/>
                        <StackPanel><TextBlock x:Name="PlayerName" Text="Select a player" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="PlayerDetails" Text="Load player metadata from your save" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8">
                            <Grid AutomationProperties.Name="Current portrait image">
                                <DockPanel><TextBlock DockPanel.Dock="Top" Text="CURRENT PORTRAIT" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}" Margin="12"/><Image x:Name="OriginalImage" AutomationProperties.Name="Current player portrait" ToolTip="Drag the original portrait into your browser chat" PreviewMouseLeftButtonDown="Original_MouseDown" MouseMove="Original_MouseMove" Stretch="Uniform" Margin="12"/><TextBlock x:Name="OriginalPath" DockPanel.Dock="Bottom" Text="No mapped portrait" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="12"/></DockPanel>
                                <TextBlock x:Name="OriginalPlaceholder" Text="Select a mapped newgen player to view the portrait" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="28" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <Border x:Name="PreviewDropTarget" Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" AllowDrop="True" DragEnter="Preview_DragEnter" DragLeave="Preview_DragLeave">
                            <Grid AutomationProperties.Name="Edited portrait preview">
                                <DockPanel><TextBlock DockPanel.Dock="Top" Text="EDIT PREVIEW" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}" Margin="12"/><Image x:Name="EditedImage" AutomationProperties.Name="Edited portrait" Stretch="Uniform" Margin="12"/><TextBlock x:Name="PreviewStatus" AutomationProperties.LiveSetting="Polite" DockPanel.Dock="Bottom" Text="Choose an edit and preview" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="12"/></DockPanel>
                                <TextBlock x:Name="EditedPlaceholder" Text="Paste the finished portrait here or drop it onto this panel" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="28" IsHitTestVisible="False"/>
                                <Rectangle x:Name="DropOutline" Stroke="{StaticResource Teal}" StrokeThickness="2" StrokeDashArray="4,3" RadiusX="7" RadiusY="7" Margin="3" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock x:Name="Activity" AutomationProperties.LiveSetting="Polite" Text="Ready" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <Expander x:Name="ErrorDetailsExpander" Header="Details" IsExpanded="False" Visibility="Collapsed" Margin="0,3,0,0">
                            <TextBox Text="{Binding ToolTip, ElementName=Activity}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="PORTRAIT CHANGES" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="1  Choose changes" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Hairstyle" FontWeight="SemiBold" FontSize="12"/><ComboBox x:Name="HairstyleBox" AutomationProperties.Name="Hairstyle" Margin="0,4,0,5" SelectionChanged="Preset_Changed" ToolTip="Choose a style that suits the player's current appearance"><ComboBoxItem Content="Keep current hairstyle" Tag="KeepCurrent" IsSelected="True"/><ComboBoxItem Content="Buzz cut" Tag="BuzzCut"/><ComboBoxItem Content="Crew cut" Tag="CrewCut"/><ComboBoxItem Content="Textured crop" Tag="TexturedCrop"/><ComboBoxItem Content="Ponytail" Tag="Ponytail"/><ComboBoxItem Content="Braids" Tag="Braids"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Facial hair (optional)" FontWeight="SemiBold" FontSize="12"/><ComboBox x:Name="BeardBox" AutomationProperties.Name="Facial hair (optional)" Margin="0,4,0,5" SelectionChanged="Preset_Changed" ToolTip="Add facial hair only when it suits the player's appearance and age"><ComboBoxItem Content="Keep current facial hair" Tag="KeepCurrent" IsSelected="True"/><ComboBoxItem Content="Light stubble" Tag="LightStubble"/><ComboBoxItem Content="Heavy stubble" Tag="HeavyStubble"/><ComboBoxItem Content="Short beard" Tag="ShortBeard"/><ComboBoxItem Content="Full beard" Tag="FullBeard"/><ComboBoxItem Content="Goatee" Tag="Goatee"/><ComboBoxItem Content="Circle beard" Tag="CircleBeard"/><ComboBoxItem Content="Van Dyke" Tag="VanDyke"/><ComboBoxItem Content="Balbo" Tag="Balbo"/></ComboBox></StackPanel>
                            </Grid>
                            <TextBlock Text="Age appearance" FontWeight="SemiBold" FontSize="12"/>
                            <ComboBox x:Name="AgeBox" AutomationProperties.Name="Age appearance" Margin="0,4,0,6" SelectionChanged="Preset_Changed" IsEnabled="False"><ComboBoxItem Content="Player age unavailable" IsSelected="True"/></ComboBox>
                            <Expander Header="View / edit prompt" IsExpanded="False" Margin="0,0,0,4"><StackPanel><TextBox x:Name="PromptBox" TextChanged="Prompt_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><Button Content="Reset to selected changes" Style="{StaticResource Secondary}" Margin="0,7,0,8" Click="ResetPrompt_Click"/></StackPanel></Expander>
                            <TextBlock Text="2  Send to your AI service" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,2,0,4"/>
                            <Button x:Name="OpenProviderButton" Style="{StaticResource Primary}" Content="Open ChatGPT" Click="OpenProvider_Click" Margin="0,0,0,4"/>
                            <TextBlock Text="3  Attach the original and prompt" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,2,0,4"/>
                            <Button x:Name="PreviewButton" ToolTipService.ShowOnDisabled="True" Content="Copy _image path" Style="{StaticResource Primary}" Margin="0,0,0,4" Click="Preview_Click"/>
                            <TextBlock x:Name="UploadPathLabel" Text="Full path to upload" FontSize="11" Foreground="{StaticResource Muted}" Visibility="Collapsed" Margin="0,0,0,4"/>
                            <TextBox x:Name="UploadPathBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="46" Visibility="Collapsed" FontSize="11" Padding="8,6" Margin="0,0,0,6" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Full upload image path"/>
                            <Button x:Name="CopyPromptButton" Style="{StaticResource Secondary}" Content="Copy pro_mpt" FontSize="12" ToolTipService.ShowOnDisabled="True" Click="CopyPromptOnly_Click" Margin="0,0,0,3"/>
                            <TextBlock Text="Paste the image path into File name, then the prompt into chat." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,0"/>
                            <TextBlock Text="4  Bring the result back" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,2,0,4"/>
                            <Button x:Name="PasteButton" Style="{StaticResource Primary}" Content="_Paste edited image" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="Paste_Click"/>
                            <TextBlock Text="Paste (Ctrl+V) or drop the result on the preview." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,2"/>
                            <CheckBox x:Name="CleanEdgesBox" Content="Reduce edge halos" IsChecked="True" Checked="CleanEdges_Changed" Unchecked="CleanEdges_Changed" ToolTip="Restores the outer two pixels from the original cutout and softens the next pixel. Toggle to compare before accepting." Margin="0,0,0,4"/>
                            <Expander Header="More options" IsExpanded="False" Margin="0"><StackPanel><Button x:Name="ImportFileButton" Style="{StaticResource Secondary}" Content="Import image file…" Click="ImportFile_Click" Margin="0,6,0,4"/></StackPanel></Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Margin="0,5,0,0">
                        <TextBlock Text="Review" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,0,0,4"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="AcceptButton" Grid.Column="0" Style="{StaticResource Primary}" Content="_Accept portrait" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="Accept_Click"/><Button x:Name="RejectButton" Grid.Column="2" Style="{StaticResource Danger}" Content="_Reject" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="Reject_Click"/></Grid>
                        <Button x:Name="HistoryButton" Style="{StaticResource Secondary}" Content="Version history" ToolTipService.ShowOnDisabled="True" Margin="0,6,0,0" Click="History_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="26,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="48"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LoadStatus" AutomationProperties.LiveSetting="Polite" Text="Ready · choose Save &amp; facepack to begin" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ConfigIssuesButton" Grid.Column="1" Style="{StaticResource Secondary}" Content="Config details" MinWidth="108" Padding="8,5" Visibility="Collapsed" Click="ConfigIssues_Click" Margin="8,0,0,0"/>
                </Grid>
                <ProgressBar x:Name="LoadProgress" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="7" Foreground="{StaticResource Teal}" Background="{StaticResource AccentSoft}" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="Source loading progress"/>
                <TextBlock x:Name="LoadPercent" Grid.Column="2" Text="0%" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <Button x:Name="CancelLoadButton" Grid.Column="3" Style="{StaticResource Secondary}" Content="Cancel" Visibility="Collapsed" Click="CancelLoad_Click" Padding="10,5" Margin="14,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
