<Window x:Class="FFM.App.HandoffSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FFM · AI provider settings" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13" Background="White" Foreground="{StaticResource Ink}">
    <StackPanel Margin="28"><TextBlock Text="AI provider settings" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Use the subscription you already have." Foreground="{StaticResource Muted}" Margin="0,8,0,20"/>
        <TextBlock Text="Image editor" FontWeight="SemiBold"/>
        <ComboBox x:Name="ProviderBox" Height="40" Margin="0,8,0,18" VerticalContentAlignment="Center" DisplayMemberPath="Name" SelectionChanged="Provider_Changed"/>
        <TextBlock Text="FFM copies the original image's full path for the browser's Add file dialog, and provides the editing prompt separately. Paste or import the finished image back into FFM for review. Sign-in and subscription usage stay on the provider's website." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        <TextBlock x:Name="Status" Text="No API key is needed. FFM does not store your provider password or browser session." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,22"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="OpenWebsiteButton" Style="{StaticResource Secondary}" Content="Open chatgpt.com" Click="Open_Click"/><Button Grid.Column="2" Style="{StaticResource Secondary}" Content="Cancel" IsCancel="True" MinWidth="90"/><Button Grid.Column="4" Style="{StaticResource Primary}" Content="Use this provider" IsDefault="True" Click="Use_Click"/></Grid>
    </StackPanel>
</Window>
