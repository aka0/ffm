<Window x:Class="FFM.App.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FFM · Portrait history" Width="670" Height="520" MinHeight="420" MinWidth="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Portrait history" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Compare a previous version with the active portrait. Restoring creates another numbered backup." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,20"/></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><ListBox x:Name="VersionsList" SelectionChanged="Version_Changed" DisplayMemberPath="Label" BorderBrush="{StaticResource Line}"/><TextBlock x:Name="EmptyState" Text="No previous versions yet. A backup is created each time you accept a portrait." TextWrapping="Wrap" Foreground="{StaticResource Muted}" TextAlignment="Center" VerticalAlignment="Center" Margin="18" IsHitTestVisible="False"/></Grid>
            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="CURRENT PORTRAIT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><Image x:Name="CurrentImage" Stretch="Uniform"/></DockPanel></Border>
                <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="SELECTED VERSION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><Image x:Name="PreviewImage" Stretch="Uniform"/><TextBlock x:Name="PreviewStatus" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></DockPanel></Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="1" Style="{StaticResource Secondary}" Content="Cancel" IsCancel="True"/><Button x:Name="ReviewButton" Grid.Column="3" Style="{StaticResource Primary}" Content="Review restoration" IsEnabled="False" Click="Review_Click"/></Grid>
    </Grid>
</Window>
